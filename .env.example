# InnSight PMS — environment for docker-compose.
#
# Copy to `.env` and set strong values, or just run:
#
#     bash scripts/gen-env.sh
#
# which generates all of them for you.
#
# These are REQUIRED. docker-compose.yml declares each secret as `${VAR:?message}`,
# so compose refuses to start until it is set — there are no fallback values any
# more. The old defaults (`innsight_dev_2025`,
# `innsight_slsu_capstone_jwt_secret_2025`) are published in this repository, so a
# stack that never wrote a .env was running on credentials anyone could read.

# Shared signing secret for all service JWTs. MUST be >= 32 characters.
# Generate one with: openssl rand -hex 32
#
# Each service also REJECTS this repo's published defaults by value, not just by
# length — the old default was 41 characters and therefore sailed past the length
# check while remaining public knowledge.
JWT_SECRET=change_me_to_a_random_32plus_char_secret

# SEPARATE signing key for machine-to-machine (service) tokens, which carry
# `svc: true`. MUST differ from JWT_SECRET and be >= 32 characters.
#   openssl rand -hex 32
#
# folio, audit and reports each used to mint their own ADMIN token with the SAME
# secret as human sessions, so compromising any one of them meant being able to
# forge a login for any user. Splitting the keys removes that.
SERVICE_JWT_SECRET=change_me_to_a_different_random_32plus_char_secret

# Postgres superuser password (interpolated into every service's DATABASE_URL).
# Avoid / + @ : ? and # — it goes into a postgresql:// URL, and those characters
# change how the URL parses.
#
# Only read when an EMPTY pgdata volume is initialised. Changing it later does not
# change the password inside an existing volume.
POSTGRES_PASSWORD=change_me

# MinIO object-store root credentials. Nothing in the codebase talks to MinIO
# (finding M7) — this exists only so compose can start the unused service.
MINIO_ROOT_USER=innsight
MINIO_ROOT_PASSWORD=change_me

# First-login password for the `admin` account, used ONCE by
# `bash scripts/db-seed.sh`. Must be >= 12 characters and must not be one of the
# values this repo has published (`admin12345` and friends are rejected).
#
# The account is created with mustChangePwd, so this value is only valid for a
# single sign-in, and the seed never logs it. The old code hardcoded `admin12345`
# and printed it to stdout on every container start.
ADMIN_INITIAL_PASSWORD=change_me_at_least_12_chars

# Hotel-local timezone — drives business-date/day-boundary logic (night audit,
# daily totals). Defaults to Asia/Manila. The Philippines has no DST, so this is a
# fixed +08:00 offset.
TZ=Asia/Manila

# ── University sign-in (Google) ───────────────────────────────────────────────
# Optional. Create an OAuth 2.0 Client ID of type "Web application" in Google
# Cloud Console, add your gateway origin (e.g. http://localhost:8080) to
# "Authorised JavaScript origins", and paste the client id here.
#
# A client id is PUBLIC — it is served to the browser by /api/auth/config. There
# is no client secret in this flow: the browser gets an ID token from Google and
# the auth service verifies its signature directly against Google's public certs.
#
# Leave empty to keep Google sign-in switched off entirely.
GOOGLE_CLIENT_ID=
# Only addresses in this domain may sign in with Google. Enforced server-side.
ALLOWED_EMAIL_DOMAIN=slsu.edu.ph
