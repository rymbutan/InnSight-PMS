generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id            String            @id @default(uuid())
  profileNumber String            @unique
  firstName     String
  middleName    String?
  lastName      String
  displayName   String?
  dateOfBirth   DateTime?
  gender        String?
  nationality   String?
  vipLevel      VipLevel          @default(NONE)
  status        GuestStatus       @default(ACTIVE)
  mergedInto    String?
  tags          Json?
  // Corporate-account info (Ms. Padilla, Lane A-07) — a guest billed through
  // an employer rather than travelling as an individual. Plain fields, not a
  // separate Company model: nothing else in this service references "the
  // company" as an entity of its own, only these two facts about this one
  // guest.
  companyName   String?
  employeeName  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  contacts      GuestContact[]
  preferences   GuestPreference[]
  consents      ConsentRecord[]
  loyalty       LoyaltyAccount?
  bankAccounts  GuestBankAccount[]
}

// A guest's saved bank-transfer detail, reusable across reservations instead
// of retyping bank/network/sender every time — the deposit step still records
// its OWN copy on the Reservation at booking time (see
// Reservation.depositBankName etc.), this only pre-fills it. Non-PCI-
// compliant capstone build, same convention ReservationCard already uses for
// cards: only what a receipt/slip already shows, masked, never a real
// recoverable account number.
model GuestBankAccount {
  id                 String   @id @default(uuid())
  guestId            String
  bankName           String
  accountName        String
  accountNumberLast4 String
  transferNetwork    String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  guest              Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

model GuestContact {
  id                String   @id @default(uuid())
  guestId           String
  type              String
  value             String
  isPrimary         Boolean  @default(false)
  optInMarketing    Boolean  @default(false)
  guest             Guest    @relation(fields: [guestId], references: [id])
}

model GuestPreference {
  id        String   @id @default(uuid())
  guestId   String
  category  String
  key       String
  value     Json
  guest     Guest    @relation(fields: [guestId], references: [id])

  @@unique([guestId, category, key])
}

model LoyaltyAccount {
  guestId          String   @id
  membershipNumber String   @unique
  tier             String   @default("BRONZE")
  pointsBalance    Int      @default(0)
  lifetimePoints   Int      @default(0)
  lifetimeNights   Int      @default(0)
  lifetimeSpend    Int      @default(0)
  enrolledAt       DateTime @default(now())
  guest            Guest    @relation(fields: [guestId], references: [id])
}

model ConsentRecord {
  id          String    @id @default(uuid())
  guestId     String
  purpose     String
  granted     Boolean
  grantedAt   DateTime?
  revokedAt   DateTime?
  legalBasis  String?
  guest       Guest     @relation(fields: [guestId], references: [id])
}

enum VipLevel {
  NONE
  SILVER
  GOLD
  PLATINUM
  BLACKLISTED
}

enum GuestStatus {
  ACTIVE
  MERGED
  ANONYMIZED
}
