generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessDay {
  id                String      @id @default(uuid())
  businessDate      DateTime    @unique
  status            DayStatus   @default(OPEN)
  roomsOccupied     Int         @default(0)
  roomsAvailable    Int         @default(0)
  occupancyPct      Float       @default(0)
  arrivals          Int         @default(0)
  departures        Int         @default(0)
  noShows           Int         @default(0)
  roomRevenueCents  BigInt      @default(0)
  // Walk-in facility sales, reported apart from otherRevenueCents at the client's
  // request. Defaulted rather than backfilled: days closed before this existed had
  // their facility income counted in otherRevenueCents, and rewriting a closed
  // business day's figures would be falsifying an audit record.
  facilityRevenueCents BigInt   @default(0)
  otherRevenueCents BigInt      @default(0)
  taxCents          BigInt      @default(0)
  paymentsCents     BigInt      @default(0)
  adr               Float       @default(0)
  revPar            Float       @default(0)
  notes             String?
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  closedBy          String?
  steps             AuditStep[]
}

model AuditStep {
  id             String      @id @default(uuid())
  businessDayId  String
  stepName       String
  status         String      @default("PENDING")
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  payload        Json?
  businessDay    BusinessDay @relation(fields: [businessDayId], references: [id])
}

enum DayStatus {
  OPEN
  CLOSING
  CLOSED
  FAILED
}

// Who did what, across every service. Written ONLY by the subscriber in
// src/subscribers/redis.subscriber.js, from the `activity:recorded` events that
// lib/activityLog.js publishes on each successful write request. Never written by
// a route — the API over this table is read-only on purpose, so the log cannot be
// edited from the screen that displays it.
//
// It lives in the audit service because that service already owns "what happened
// to the property", is already proxied at the gateway, and its Redis subscriber
// was a documented no-op waiting for exactly this.
//
// NOTE ON PII: there is deliberately no body/payload column. See the header of
// lib/activityLog.js — request bodies here would mean storing passwords and guest
// data in a table an admin browses casually.
model ActivityLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  service    String
  // Null for the handful of successful writes with no session — a guest
  // completing a public booking, or a password reset redeemed by token.
  actorId    String?
  actorName  String   @default("unknown")
  actorRoles String[] @default([])
  // Stable, filterable key: "reservations.cancel", "auth.login", "folios.create".
  action     String
  // Human-readable line shown in the admin table.
  summary    String
  method     String
  path       String
  targetType String?
  targetId   String?
  status     Int
  requestId  String?
  ip         String?

  // The admin screen's three queries: newest-first overall, newest-first for one
  // person, and newest-first for one action. Each needs `at` as the trailing
  // column or Postgres sorts the match set by hand.
  @@index([at])
  @@index([actorId, at])
  @@index([action, at])
  @@index([service, at])
}
