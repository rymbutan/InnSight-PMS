generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reservation {
  id                    String                 @id @default(uuid())
  confirmationNumber    String                 @unique
  guestId               String?
  guestName             String
  guestEmail            String?
  guestPhone            String?
  roomTypeCode          String
  ratePlanId            String?
  assignedRoomId        String?
  checkIn               DateTime
  checkOut              DateTime
  nights                Int
  adults                Int                    @default(1)
  children              Int                    @default(0)
  status                ReservationStatus      @default(PENDING)
  source                String?                @default("DIRECT")
  totalEstimateCents    BigInt                 @default(0)
  depositCents          BigInt                 @default(0)
  specialRequests       String?
  addOns                Json?
  expectedArrivalTime   String?
  paymentType           String?
  // Per-method deposit detail, mirroring the fields Folio's own payment
  // record carries (services/folio/src/prisma/schema.prisma's Payment model).
  // Only the sub-fields relevant to paymentType are ever populated.
  depositCardMasked        String?
  depositCardholderName    String?
  depositBankName          String?
  depositTransferNetwork   String?
  depositSenderName        String?
  depositGatewayRef        String?
  depositTransferredAt     DateTime?
  depositFeeCents          BigInt    @default(0)
  // Promotional / non-refundable rate: per the Terms & Conditions, always
  // forfeits the full amount on cancellation regardless of timing.
  isNonRefundable       Boolean                @default(false)
  ratePlan              String?
  origin                String?
  cancellationNumber    String?
  cancellationReason    String?
  cancellationFeeCents  BigInt                 @default(0)
  cancelledAt           DateTime?
  cancelledBy           String?
  createdBy             String?
  // The inventory hold group that reserves this booking's capacity. Written at
  // creation so a cancellation or date change can release exactly the right
  // hold instead of guessing from (roomTypeCode, dates).
  inventoryHoldGroupId  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  notes                 ReservationNote[]
  activity              ReservationActivity[]
  cards                 ReservationCard[]
  documents             ReservationDocument[]
  notifications         NotificationLog[]

  // The calendar and arrivals views filter on checkIn + status and order by
  // checkIn. With only confirmationNumber indexed, every one of those queries
  // was a sequential scan on the busiest table in the system.
  @@index([checkIn, status])
  @@index([checkOut])
  // The calendar's date window is an OVERLAP test — `checkIn < to AND
  // checkOut > from` — and sends no status, so ([checkIn, status]) covered only
  // half of it. See migrations/20260903000100_calendar_window_and_room_ids.
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([roomTypeCode, checkIn])
  @@index([assignedRoomId])
  @@index([guestId])
  @@index([inventoryHoldGroupId])
}

model ReservationNote {
  id            String      @id @default(uuid())
  reservationId String
  author        String?
  body          String
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model ReservationActivity {
  id            String      @id @default(uuid())
  reservationId String
  userId        String?
  userName      String?
  action        String      // "create", "confirm", "cancel", "no_show", "modify_dates", "check_in", etc.
  summary       String      // human-readable, e.g. "Status changed CONFIRMED → CANCELLED"
  payload       Json?       // optional structured detail
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

// A card ON FILE as a guarantee for the booking — not a payment. This is a
// non-PCI-compliant capstone build, so the schema itself makes storing a real
// card number impossible: there is no field that could hold one, only what a
// receipt already shows (brand, last 4, expiry, cardholder name). An actual
// charge still goes through Folio.Payment (services/folio), same as any other
// payment method.
model ReservationCard {
  id             String      @id @default(uuid())
  reservationId  String
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  cardholderName String
  createdAt      DateTime    @default(now())
  createdBy      String?
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// Metadata only — the bytes live in MinIO under objectKey (see lib/storage.js).
// Nothing here can be used to reconstruct a file without going through that
// client, so a leaked database row leaks a filename, not a document.
model ReservationDocument {
  id            String      @id @default(uuid())
  reservationId String
  filename      String
  contentType   String
  sizeBytes     Int
  objectKey     String      @unique
  uploadedAt    DateTime    @default(now())
  uploadedBy    String?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// Every attempted booking-confirmation dispatch — Email, SMS, and Viber
// alike, win or lose. Email already has Mailhog as an inspectable "sent mail"
// view; SMS and Viber have no such tool, because there is no real SMS/Viber
// provider anywhere in this stack (see docker-compose.yml's "RUNNING OFFLINE"
// note — a live third-party API would break that constraint outright). This
// is the only record of what would have gone out and to whom.
model NotificationLog {
  id            String              @id @default(uuid())
  reservationId String
  channel       NotificationChannel
  to            String
  subject       String?
  body          String
  status        String              @default("SENT") // SENT | FAILED
  error         String?
  sentAt        DateTime            @default(now())
  reservation   Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, sentAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  VIBER
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}
