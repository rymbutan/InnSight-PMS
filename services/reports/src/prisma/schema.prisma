generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReportRun {
  id        String   @id @default(uuid())
  type      String
  params    Json?
  result    Json?
  runBy     String?
  runAt     DateTime @default(now())
  status    String   @default("COMPLETED")
  errorMsg  String?
}
