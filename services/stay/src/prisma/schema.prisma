generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stay {
  id                String      @id @default(uuid())
  reservationId     String?
  guestId           String?
  assignedRoomId    String?
  folioId           String?
  actualCheckInAt   DateTime?
  actualCheckOutAt  DateTime?
  status            StayStatus  @default(PRE_ARRIVAL)
  keyCardsIssued    Int         @default(0)
  idVerification    Json?
  depositAmount     Int         @default(0)
  guestName         String?
  // Set on walk-ins (which have no backing Reservation to source a rate/party
  // size from) so the folio subscriber can post room charges the same way it
  // does for a reserved stay, and so occupancy displays consistently.
  nightlyRateCents  Int?
  adults            Int?
  children          Int?
  expectedCheckIn   DateTime?
  expectedCheckOut  DateTime?
  // A walk-in has no backing Reservation, so nowhere else to record what
  // NewReservation.jsx's wizard already collects for a reserved booking —
  // these mirror Reservation's own fields (services/reservation/src/prisma/
  // schema.prisma) so a walk-in can carry the same detail.
  specialRequests        String?
  addOns                 Json?
  paymentType            String?
  depositCardMasked      String?
  depositCardholderName  String?
  depositBankName        String?
  depositTransferNetwork String?
  depositSenderName      String?
  depositGatewayRef      String?
  depositTransferredAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tasks             CheckInTask[]

  // This table had ZERO indexes, yet /api/arrivals, /api/departures and
  // /api/in-house all filter it and the night audit scans it per business day.
  //
  // NOTE: uniqueness of (assignedRoomId WHERE status = 'IN_HOUSE') is enforced by
  // a PARTIAL unique index, which Prisma cannot express — see the raw SQL in
  // migrations/. That constraint is the database-level backstop behind
  // validateRoomAssignment(); do not drop it.
  @@index([status, expectedCheckIn])
  @@index([status, expectedCheckOut])
  @@index([assignedRoomId, status])
  @@index([reservationId])
  @@index([folioId])
  @@index([guestId])
}

model CheckInTask {
  taskId       String  @id @default(uuid())
  stayId       String
  steps        Json
  currentStep  String
  stepStatus   String  @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stay         Stay    @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
}

enum StayStatus {
  PRE_ARRIVAL
  IN_HOUSE
  DEPARTED
  NO_SHOW
}
