generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Folio {
  id            String             @id @default(uuid())
  folioNumber   String             @unique
  stayId        String?
  guestId       String?
  // Who this folio bills, when that is not simply the guest whose stay it is.
  // Set per payer by a bill split; null on every folio without a distinct payer,
  // which then falls back to the stay's guest name on the printed document.
  payerName     String?
  // The credential on the QR code printed in the folio's header: a stranger who
  // guesses it can read this one folio's PDF and nothing else, unauthenticated
  // (see /api/public/folios/:token/pdf). Generated lazily on first print rather
  // than at folio creation, since most folios are never scanned and most are
  // never split into new ones either — no code path should be required to
  // remember to set it.
  publicToken   String?            @unique
  type          FolioType          @default(GUEST)
  status        FolioStatus        @default(OPEN)
  currency      String             @default("PHP")
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transactions  FolioTransaction[]
  payments      Payment[]

  // /api/folios filters on status and stayId; daily-totals filters on openedAt.
  @@index([status, openedAt])
  @@index([stayId])
  @@index([guestId])
}

model FolioTransaction {
  id                String           @id @default(uuid())
  folioId           String
  type              TransactionType
  chargeCode        String?
  description       String
  amountCents       BigInt
  taxAmountCents    BigInt           @default(0)
  // Per-component tax for the printed folio: [{ key, label, rate, amountCents }]
  // with amountCents as a decimal STRING, because JSON cannot carry BigInt.
  //
  // taxAmountCents above stays the single source of truth for every total and
  // balance — this column is presentation detail layered on top. Rows written
  // before this migration are null and print their whole tax as VAT, so no
  // historical folio's figures move.
  taxBreakdown      Json?
  quantity          Int              @default(1)
  note              String?
  paymentMethod     String?
  postedAt          DateTime         @default(now())
  postedBy          String?
  sourceSystem      String?
  reversalOf        String?
  refundOfId        String?          // links a refund/negative-payment to its original payment
  refundReason      String?
  reference         String?
  folio             Folio            @relation(fields: [folioId], references: [id], onDelete: Cascade)

  // folioId was unindexed despite being the join path for every statement,
  // print and daily-total query — the hottest read path in the folio service.
  @@index([folioId, postedAt])
  // The night audit looks up its own AUDIT-<day>-<stayId> reference to avoid
  // double-charging a guest on a re-run; without this that is a table scan.
  @@index([reference])
  @@index([chargeCode])
}

model ChargeCode {
  code      String   @id
  name      String
  category  String
  glAccount String?
  taxable   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Payment {
  id          String        @id @default(uuid())
  folioId     String
  method      String
  amountCents BigInt
  gatewayRef  String?
  status      PaymentStatus @default(AUTHORIZED)
  cardMasked  String?
  createdAt   DateTime      @default(now())
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId, createdAt])
  @@index([status])
}

enum FolioType {
  GUEST
  MASTER
  GROUP
  HOUSE
  WALKIN
}

enum FolioStatus {
  OPEN
  LOCKED
  CLOSED
  VOIDED
}

enum TransactionType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  TAX
  REFUND
  TRANSFER
}

enum PaymentStatus {
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

// A pending simulated payment, addressed by a QR code.
//
// A row rather than a signed token on purpose: an instructor can SHOW students the
// pending intent, and single-use enforcement comes free from a status column that
// is flipped inside the same transaction as the payment.
model PaymentIntent {
  id          String              @id @default(uuid())
  token       String              @unique
  folioId     String
  amountCents BigInt
  method      String              @default("QR_WALLET")
  status      PaymentIntentStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())
  createdBy   String?
  // Set only when this intent was emailed rather than shown as an in-person QR —
  // null for the original scan-in-front-of-the-guest flow, so "Sent Pay by Link"
  // can list just the ones actually sent somewhere.
  sentTo      String?

  @@index([folioId, status])
}

enum PaymentIntentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

// A refund request or chargeback filed against an E-WALLET payment
// (GCash, Maya — see lib/paymentMethods.js's E-wallet category). Cash and
// card payments use the existing direct /refund route unchanged; a wallet
// claim gets its own tracked case because, unlike a desk-initiated refund, it
// can arrive from the gateway itself (a chargeback) rather than from staff,
// and its outcome is not always known the moment it is filed.
//
// No relation fields to Payment/Folio, matching PaymentIntent above: this is
// a plain reference, not a Prisma relation, so no FK migration complexity.
model PaymentDispute {
  id             String               @id @default(uuid())
  folioId        String
  paymentId      String
  // The e-wallet this claim is against (GCASH, MAYA, or the generic
  // QR_WALLET). Not any method — see the route guard.
  method         String
  type           PaymentDisputeType
  status         PaymentDisputeStatus @default(PENDING)
  amountCents    BigInt
  reason         String?
  filedBy        String?
  filedAt        DateTime             @default(now())
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?
  // Set only once APPROVED — the id of the REFUND FolioTransaction this case
  // produced, so the case and the money movement it caused stay linked for
  // audit without duplicating the refund logic that already exists.
  refundTxId     String?

  @@index([folioId])
  @@index([paymentId])
  @@index([status])
}

enum PaymentDisputeType {
  REFUND_REQUEST
  CHARGEBACK
}

// PENDING → APPROVED (executes the refund) | REJECTED (no money moves) | DISPUTED
// (escalated to the gateway; outcome not yet known). DISPUTED → APPROVED |
// REJECTED once that outcome is known. APPROVED and REJECTED are terminal.
enum PaymentDisputeStatus {
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

// Folio-service configuration: tax component rates and the hotel identity block
// printed at the top of a guest folio. Mirrors the reservation service's
// AppSetting rather than sharing it, because posting a charge must not depend on
// the reservation service being reachable.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
