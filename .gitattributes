# Shell scripts run under /bin/sh inside the Linux service images — every
# service Dockerfile COPYs its db-init.sh in and the CMD runs it. A CRLF
# checkout (git's core.autocrlf=true is the Windows default) makes the shell
# read `set -e` with a trailing carriage return, which fails as
# "set: illegal option -" and crash-loops all nine containers on boot.
# These must stay LF no matter how the developer's git is configured.
*.sh text eol=lf

# .prettierrc.json sets endOfLine: "lf". Without this, core.autocrlf=true
# (git's Windows default) checks these out as CRLF, and `prettier --check`
# then reports every single line of the file as a style violation — not a
# real formatting problem, just the checkout disagreeing with the config. It
# reads as "the whole repo fails Lint & format" when only this file's
# checkout does.
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
